{
  "$schema": "https://json-schema.org/schema",
  "$id": "AppLib",
  "title": "Create a library inside an existing app",
  "type": "object",
  "properties": {
    "app": {
      "type": "string",
      "description": "The existing app to add the library to (e.g. visitor).",
      "$default": { "$source": "argv", "index": 0 },
      "x-prompt": "Which app?"
    },
    "kind": {
      "type": "string",
      "description": "Which layer the library represents.",
      "enum": ["feature", "slice", "data-access", "ui"],
      "$default": { "$source": "argv", "index": 1 },
      "x-prompt": "Which kind of library?"
    },
    "name": {
      "type": "string",
      "description": "Lib name — required for feature, optional otherwise to add a second lib of the same kind (e.g. a 2nd data-access).",
      "$default": { "$source": "argv", "index": 2 }
    }
  },
  "required": ["app", "kind"]
}
