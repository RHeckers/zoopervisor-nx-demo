{
  "$schema": "https://json-schema.org/schema",
  "$id": "SharedLib",
  "title": "Create a shared library under libs/shared",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "description": "Which layer the shared library represents.",
      "enum": ["data-access", "ui", "util", "types"],
      "$default": { "$source": "argv", "index": 0 },
      "x-prompt": "Which kind of shared library?"
    },
    "platform": {
      "type": "string",
      "description": "Restrict the library to a platform (ui only).",
      "enum": ["mobile", "desktop"]
    }
  },
  "required": ["kind"]
}
