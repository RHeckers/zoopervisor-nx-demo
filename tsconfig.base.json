{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "paths": {
      "@zoo/nx-preset-zoo": ["./tools/nx-preset-zoo/src/index.ts"],
      "@zoo/shared/types": ["libs/shared/types/src/index.ts"],
      "@zoo/shared/utils": ["libs/shared/utils/src/index.ts"],
      "@zoo/shared/data-access": ["libs/shared/data-access/src/index.ts"],
      "@zoo/shared/ui": ["libs/shared/ui/src/index.ts"],
      "@zoo/shared/ui/mobile": ["libs/shared/ui/mobile/src/index.ts"],
      "@zoo/shared/ui/desktop": ["libs/shared/ui/desktop/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
